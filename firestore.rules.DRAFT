// مسودة فقط — لا تنشري هذا الملف قبل اختبار Firebase Emulator.
// لا يستبدل قواعد المشروع الحالية تلقائيًا.
// تحقق من صلاحية المعلمة في users/{uid} قبل دمج هذه القواعد.
// IMPORTANT: Firestore rules do not conceal fields. Only publish answer-free questions.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function anonymousStudent() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // Maintain existing teacher-only access for private collections.
    match /students/{id} { allow read, write: if teacher(); }
    match /tests/{id} { allow read, write: if teacher(); }
    match /results/{id} { allow read, write: if teacher(); }
    match /remedialPlans/{id} { allow read, write: if teacher(); }
    match /users/{id} { allow read, write: if teacher(); }

    // Only teacher creates sanitized copies WITHOUT correct answers.
    match /publishedTests/{testId} {
      // Question-only documents; anyone with the test ID and anonymous session
      // can see the questions. The test ID is NOT an answer key or private record.
      allow get: if teacher() || anonymousStudent();
      allow list: if teacher();
      allow create, update: if teacher()
        && request.resource.data.keys().hasOnly(['id','title','items','state'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100;
      // NOTE: rules cannot reliably verify every nested question lacks a
      // 'correct' field. Teacher publishing code MUST use an explicit allowlist.
      allow delete: if teacher();
    }

    // A code is a high-entropy bearer secret (at least 128 random bits).
    // Student can fetch ONLY the document whose code they already know.
    // Never include student names, answers, scores or personal IDs in this document.
    match /examAccess/{code} {
      allow get: if teacher() || anonymousStudent();
      allow list: if teacher();
      allow create, update, delete: if teacher();
    }

    // Students may create ONE submission for a valid code, never write scores.
    // A guessed/stolen code can be used once; sharing codes remains a risk.
    match /examSubmissions/{code} {
      allow get, list: if teacher();
      allow create: if anonymousStudent()
        && exists(/databases/$(database)/documents/examAccess/$(code))
        && request.resource.data.keys().hasOnly(['testId','answers','submittedAt'])
        && request.resource.data.testId ==
          get(/databases/$(database)/documents/examAccess/$(code)).data.testId
        && request.resource.data.answers is list
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 100
        && request.resource.data.submittedAt == request.time;
      allow update, delete: if teacher();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
